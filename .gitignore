# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# impeccable (design-QA skill) — engine binary is fetched per platform on
# first run and never tracked; the launcher script next to it is.
**/skills/impeccable/scripts/bin/
# Runtime/local state (critique snapshots, hook cache, live-mode session
# files) — not shareable build output. PRODUCT.md/DESIGN.md, if created,
# stay tracked (durable project context, not runtime state).
/.impeccable/
